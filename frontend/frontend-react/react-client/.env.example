# true: simulación local en el navegador (el backend de turnos aún no existe).
# false: consumir los endpoints de Spring Boot.
VITE_USE_TURNOS_SIMULATION=true

# Solo se usa cuando VITE_USE_TURNOS_SIMULATION=false.
# Confirmar el puerto con el responsable del backend.
VITE_API_BASE_URL=http://localhost:8080
